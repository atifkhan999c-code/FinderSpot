# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/lost_and_found_db

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Base Web App URL (for email buttons and deep links)
APP_BASE_URL=http://localhost:5000

# Automated Email Notifications (Nodemailer / SendGrid / SMTP)
# Leave EMAIL_HOST and EMAIL_USER empty to run in Development mode with auto-generated Ethereal test inboxes
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="FinderSpot Campus Portal <notifications@finderspot.edu>"

# Google Gemini API Configuration (Multimodal Visual AI Recognition)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Supabase Database & Storage Integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=
